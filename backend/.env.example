# Copy to backend/.env and fill in. backend/.env is git-ignored; never commit real keys.

# Answer provider: auto | gemini | claude | demo
#   auto = gemini if GEMINI_API_KEY is set, else claude if ANTHROPIC_API_KEY is set, else canned demo answers
MESHMIND_PROVIDER=auto

# Google AI Studio key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-gemini-api-key-here
# Cheapest Gemini model with a free tier that includes Google Search grounding
MESHMIND_GEMINI_MODEL=gemini-2.5-flash-lite

# Optional: Claude instead of Gemini
# ANTHROPIC_API_KEY=your-anthropic-api-key-here
# MESHMIND_MODEL=claude-opus-5-5

# 1 = show the OTP in the app instead of sending an SMS (demos)
MESHMIND_DEMO_OTP=1
# Code a phone must enter to verify as ORGANIZER or RESPONDER
MESHMIND_ORGANIZER_CODE=demo-organizer
# Token for posting organizer notices (POST /v1/notices). Empty = random token printed at startup.
MESHMIND_ADMIN_TOKEN=
# Where people are (helps the AI answer locally)
MESHMIND_CONTEXT=They are at a large event in Bengaluru, India.
